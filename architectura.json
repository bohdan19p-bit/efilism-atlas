  "principles": [
    {
      "id": "A1",
      "title": "Феноменальная антиценность",
      "antecedents": [
        "negative_experience",
        "observer_invariant"
      ],
      "conclusion": "local_disvalue",
      "body": "Отрицательное качество опыта составляет неблагоприятный аспект для его носителя. Аксиологическая гипотеза, не вывод из физикализма.",
