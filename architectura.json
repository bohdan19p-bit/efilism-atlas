      ]
    },
    {
      "id": "A4",
      "title": "Независимость критерия от носителя",
      "antecedents": [
        "comparable_experience"
      ],
      "conclusion": "equal_criterion",
      "body": "При сопоставимых свойствах опыта применяется одинаковый критерий без видовой или субстратной скидки. Не тождество решений при разных обстоятельствах.",
      "related": "ARG-11",
      "independence_witnesses": [
        {
          "case": "C7",
          "lost": [
            "equal_criterion"
          ]
        },
        {
          "case": "C8",
          "lost": [
            "equal_criterion"
          ]
        }
      ]
    },
    {
      "id": "A5",
      "title": "Асимметрия несоздания",
      "antecedents": [
        "no_subject",
        "no_independent_claim"
      ],
      "conclusion": "no_deprivation_claim",
      "body": "В рассматриваемом случае несоздание не лишает уже существующего субъекта блага и не нарушает независимое притязание. Не утверждение об отсутствии всех внешних последствий.",
      "related": "ARG-07",
      "independence_witnesses": [
        {
          "case": "C2",
          "lost": [
            "no_deprivation_claim"
          ]
        }
      ]
    },
    {
      "id": "A6",
      "title": "Антижертвенный защитный принцип",
      "antecedents": [
        "creation",
        "severe_risk",
        "no_prior_authorization",
        "no_independent_claim",
        "abstention_feasible"
      ],
      "conclusion": "forbid_action",
      "body": "Кандидатный принцип: добровольное несоздание предпочтительно, когда создание навязывает существенный риск крайнего вреда без предварительной авторизации и независимой необходимости. Условия требуют проверки, принцип не доказан перечислением.",
      "related": "ARG-09",
      "independence_witnesses": [
        {
          "case": "C3",
          "lost": [
            "forbid_action"
          ]
        }
      ]
    },
    {
      "id": "A7",
      "title": "Допустимость помощи",
      "antecedents": [
        "existing_subject",
        "help",
        "authorized_help",
        "proportionate_help",
        "independent_permission"
      ],
      "conclusion": "permit_action",
      "body": "Разрешение конкретного средства требует независимого обоснования, согласия либо надлежащей защиты интересов, и соразмерности. Не лицензия на вмешательство.",
      "related": "ARG-12",
      "independence_witnesses": [
        {
          "case": "C5",
          "lost": [
            "permit_action"
          ]
        }
      ]
    },
    {
      "id": "A8",
      "title": "Независимость допустимости средств",
      "antecedents": [
        "coercive_means",
        "no_independent_permission"
      ],
      "conclusion": "forbid_means",
      "body": "Этическое несогласие с действием не разрешает принуждение. В данном случае средство без независимого оправдания запрещено.",
      "related": "LOG-T12",
      "independence_witnesses": [
        {
          "case": "C6",
          "lost": [
            "forbid_means"
          ]
        }
      ]
    },
    {
      "id": "A9",
      "title": "Предосторожность при неопределённости",
      "antecedents": [
        "creation",
        "risk_unresolved"
      ],
      "conclusion": "require_assessment",
      "body": "Неопределённость существенного риска создаёт требование дополнительной оценки; отсутствие данных не означает безопасность и само по себе не устанавливает категорический запрет.",
      "related": "LOG-T18",
      "independence_witnesses": [
